	  <!-- WhatsApp Module — md.enotify.app Configuration              -->
	  <!-- ═══════════════════════════════════════════════════════════ -->
	  <!-- Step 1: Login to https://md.enotify.app                     -->
	  <!-- Step 2: Go to Devices → copy Instance ID                    -->
	  <!-- Step 3: Go to API Settings → copy Access Token              -->
	  <!-- Step 4: Replace placeholder values below                    -->
	  <add key="EnableWhatsAppNotification" value="True" />
	  <add key="WhatsApp_ApiBaseUrl" value="https://enotify.app/api/sendText" />
	  <add key="WhatsApp_InstanceId" value="bnmogmlj5we0t4n3qip7y57q" />
	  <add key="WhatsApp_AccessToken" value="czRnb0RmR1QyQ0pQZ2M5VmJyUGZXV0Q1X3RJLUR5NWpTalAyc2FBVjhVQTo=" />
	  <add key="WhatsApp_CountryCode" value="91" />
	  <add key="WhatsApp_ClubName" value="Cosmopolitan Club" />
	  <add key="WhatsApp_TestPhone" value="" />
	  <!--<add key="WhatsApp_TestPhone" value="919949688844" />-->
	  <!-- Leave blank to use default path: Content\Config\whatsapp-templates.json -->
	  <add key="WhatsApp_TemplateFile" value="Content\Config\whatsapp-templates.json" />

	  <add key="MembershipFeePaid_Template" value="membership_fee_success" />
	  <add key="SportsFeePaid_Template" value="sports_fee_success" />
	  <add key="LockerFeePaid_Template" value="locker_fee_success" />
	  <add key="FeeReminder_Template" value="membership_fee_reminder" />
